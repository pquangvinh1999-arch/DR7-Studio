    },
    "air_slash_a_fx": {
      "contract": "action-air_slash_a_fx.json",
      "loop": false,
      "clip": "air_slash_a_fx"
    },
    "air_slash_b_fx": {
      "contract": "action-air_slash_b_fx.json",
      "loop": false,
      "clip": "air_slash_b_fx"
    },
    "air_slash_c_fx": {
      "contract": "action-air_slash_c_fx.json",
