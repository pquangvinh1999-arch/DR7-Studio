    "walk": {
      "contract": "action-walk.json",
      "loop": true,
      "clip": "walk"
    },
    "attack_nomal": {
      "contract": "action-attack_nomal.json",
      "loop": false,
      "clip": "attack_nomal"
    },
    "power_up": {
      "contract": "action-power_up.json",
      "loop": false,
      "clip": "power_up"
    },
    "hit": {
      "contract": "action-hit.json",
      "loop": false,
      "clip": "hit"
    },
    "ko": {
      "contract": "action-ko.json",
      "loop": false,
      "clip": "ko"
    },
    "power_orb_loop": {
      "contract": "action-power_orb_loop.json",
      "loop": true,
      "clip": "power_orb_loop"
    },
    "power_orb_projectile": {
      "contract": "action-power_orb_projectile.json",
      "loop": false,
      "clip": "power_orb_projectile"
    }
  }
